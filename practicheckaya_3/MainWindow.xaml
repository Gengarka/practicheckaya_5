<Window x:Class="practicheckaya_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обувная фабрика" Height="600" Width="900" 
        Icon="/Resources/icon.png"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF541008">
            <Image Width="55" Height="55"
                   HorizontalAlignment="Left" Margin="20,0,0,0"
                   Source="/Resources/icon.png"/>
            <TextBlock Text="Обувная фабрика"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="Comic Sans MS"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Grid>

        <Frame x:Name="FrmMain" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>