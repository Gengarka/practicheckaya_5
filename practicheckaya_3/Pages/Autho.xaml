<Page x:Class="practicheckaya_3.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <TextBlock Text="Вход в систему" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,15"/>
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="txtLogin" Height="25" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="txtPassword" Height="25" Margin="0,0,0,10"/>

            <StackPanel x:Name="captchaPanel" Visibility="Hidden">
                <TextBlock Text="Капча:"/>
                <TextBlock x:Name="tblCaptcha"
                           FontSize="18"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           TextDecorations="Strikethrough"
                           Foreground="#A00000"
                           Margin="0,2,0,4"/>
                <TextBox x:Name="txtCaptcha" Height="25" Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="btnEnter" Content="Войти" Click="btnEnter_Click" Width="100" Margin="5"/>
                <Button Name="btnRegister" Content="Регистрация" Click="btnRegister_Click" Width="100" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>